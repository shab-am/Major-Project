# ===============================
# Hydroponics Frontend Runtime Env
# ===============================

# React app talks to the Flask backend.
# If frontend and backend run on the same hardware system, keep localhost.
# If opening the website from another laptop, replace localhost with the backend machine IP.
REACT_APP_API_URL=http://localhost:5000
REACT_APP_PYTHON_API_URL=http://localhost:5000
REACT_APP_WS_URL=ws://localhost:5000

# Keep demo streams off for the real hardware setup.
REACT_APP_USE_DEMO_DATA=false
REACT_APP_SENSOR_STRESS_DEMO=false
