# API base URL (Flask backend)
REACT_APP_API_URL=http://localhost:5000

# Set to true to always request demo stream (?demo=1). Default: use navbar toggle (localStorage).
# REACT_APP_USE_DEMO_DATA=true

# Stress-test: backend sends out-of-band readings so every plant gets issue alerts (?stress_demo=1).
# Or in the browser: localStorage.setItem('hydroStressDemo','1'); location.reload()
# REACT_APP_SENSOR_STRESS_DEMO=true
