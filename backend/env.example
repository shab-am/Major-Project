# MariaDB Database Configuration
DB_USER=hydro_user
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hydroponics_db

# Live hardware mode
SIMULATION_MODE=false
USE_DEMO_DATA=false
HEALTHY_OUTPUT_MODE=true
SUPPRESS_RANGE_ALERTS=true
SOCKET_SERVER_URL=http://localhost:5000

# Serial Port Configuration
# final_sensor/final_sensor.ino -> SERIAL_PORT, exactly 8 CSV values
# spe_electrode/spe_electrode.ino -> POTENTIOSTAT_PORT, one float
# Windows: COM3, COM4, etc.
# Linux: /dev/ttyUSB0, /dev/ttyACM0, etc.
# macOS: /dev/cu.usbmodem*, /dev/tty.usbmodem*
SERIAL_PORT=COM3
POTENTIOSTAT_PORT=COM4
BAUD_RATE=115200

# Timing
COLLECTOR_LOOP_DELAY_SECONDS=1.0
SENSOR_READ_TIMEOUT_SECONDS=8.0
POTENTIOSTAT_STALE_SECONDS=15.0
SERIAL_DEBUG=false

