# Live hardware mode
SIMULATION_MODE=false
USE_DEMO_DATA=false
SOCKET_SERVER_URL=http://localhost:5000

# MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=hydro_user
DB_PASSWORD=your_password
DB_NAME=hydroponics_db

# final_sensor/final_sensor.ino
SERIAL_PORT=COM3

# spe_electrode/spe_electrode.ino
POTENTIOSTAT_PORT=COM4

BAUD_RATE=115200
COLLECTOR_LOOP_DELAY_SECONDS=1.0
SENSOR_READ_TIMEOUT_SECONDS=8.0
POTENTIOSTAT_STALE_SECONDS=15.0
SERIAL_DEBUG=false
