# ==============================
# Hydroponics Backend Runtime Env
# ==============================

# Live hardware mode. Keep both false when connected to the actual setup.
SIMULATION_MODE=false
USE_DEMO_DATA=false
HEALTHY_OUTPUT_MODE=true
SUPPRESS_RANGE_ALERTS=true

# Flask / Socket.IO backend URL used by backend/scripts/data_collector.py
SOCKET_SERVER_URL=http://localhost:5000

# MariaDB connection used by backend/app.py and backend/scripts/data_collector.py
DB_HOST=localhost
DB_PORT=3306
DB_USER=hydro
DB_PASSWORD=hydro
DB_NAME=hydroponics_db

# Arduino serial configuration.
# final_sensor/final_sensor.ino must be on SERIAL_PORT and sends exactly 8 CSV values.
# spe_electrode/spe_electrode.ino must be on POTENTIOSTAT_PORT and sends one float.
#
# Windows examples: COM3, COM4
# Raspberry Pi / Linux examples: /dev/ttyACM0, /dev/ttyUSB0
SERIAL_PORT=/dev/ttyACM0 #spe
POTENTIOSTAT_PORT=/dev/ttyUSB0 #finalsensor
BAUD_RATE=115200

# Timing. Sensor Arduino emits every 1 second; frontend still refreshes every 5 seconds.
COLLECTOR_LOOP_DELAY_SECONDS=1.0
SENSOR_READ_TIMEOUT_SECONDS=3.0
POTENTIOSTAT_STALE_SECONDS=15.0

# Set true only while debugging raw serial lines.
SERIAL_DEBUG=false
